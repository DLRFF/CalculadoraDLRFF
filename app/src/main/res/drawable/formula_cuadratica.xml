    <path android:strokeColor="#6750A4" android:strokeWidth="1.5" android:pathData="M78,23L84,30M84,23L78,30"/>
    <!-- + -->
    <path android:strokeColor="#6750A4" android:strokeWidth="1.5" android:pathData="M90,26h6M93,23v6"/>
