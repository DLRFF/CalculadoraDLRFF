    <path android:strokeColor="#6750A4" android:strokeWidth="1.2" android:pathData="M52,21c0,-2 2,-2 3,-1c1,1 -3,4 3,4h-3"/>
    <!-- + -->
    <path android:strokeColor="#6750A4" android:strokeWidth="1.5" android:pathData="M60,26h6M63,23v6"/>
