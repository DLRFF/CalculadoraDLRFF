    <path android:strokeColor="#49454F" android:strokeWidth="1.5" android:pathData="M263,41c-1,-1 -3,0 -3,2s2,2 3,1"/>

    <!-- Línea de división de la fracción -->
    <path android:strokeColor="#1D1B20" android:strokeWidth="2" android:pathData="M180,51h102"/>

    <!-- Denominador: 2a -->
    <path android:strokeColor="#1D1B20" android:strokeWidth="1.8" android:pathData="M224,57c0,-2 3,-2 4,-1s-4,4 4,4h-4"/>
    <path android:strokeColor="#1D1B20" android:strokeWidth="1.8" android:pathData="M234,61c-1,-1 -2,0 -2,2s1,2 2,2v-4"/>
