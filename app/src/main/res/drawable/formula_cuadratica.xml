    <!-- = 0 -->
    <path android:strokeColor="#6750A4" android:strokeWidth="1.5" android:pathData="M112,25h6M112,28h6M124,26c0,-3 3,-4 4,-4s4,1 4,4s-3,4 -4,4s-4,-1 -4,-4z"/>

    <!-- Fórmula cuadrática: x = (-b ± √(b² - 4ac)) / (2a) -->
    <!-- 'x =' -->
    <path android:strokeColor="#1D1B20" android:strokeWidth="2" android:pathData="M150,46L158,56M158,46L150,56"/>
    <path android:strokeColor="#1D1B20" android:strokeWidth="2" android:pathData="M165,49h10M165,53h10"/>

    <!-- Numerador: -b ± √(b² - 4ac) -->
    <!-- -b -->
    <path android:strokeColor="#1D1B20" android:strokeWidth="2" android:pathData="M182,43h7"/>
    <path android:strokeColor="#1D1B20" android:strokeWidth="2" android:pathData="M193,36v11M193,42c1,-2 4,-2 4,1s-3,3 -4,3"/>
    <!-- ± -->
    <path android:strokeColor="#1D1B20" android:strokeWidth="1.8" android:pathData="M201,42h6M204,39v6M201,46h6"/>
    <!-- Símbolo de raíz cuadrada √ -->
    <path android:strokeColor="#1D1B20" android:strokeWidth="2" android:strokeLineJoin="round" android:pathData="M211,44L213,46L217,35L278,35"/>
    <!-- b² - 4ac dentro de la raíz -->
    <path android:strokeColor="#49454F" android:strokeWidth="1.5" android:pathData="M222,38v7M222,42c1,-1 3,-1 3,1s-2,2 -3,2"/>
    <path android:strokeColor="#49454F" android:strokeWidth="1.2" android:pathData="M227,39c0,-1 1,-1 2,0s-2,2 2,2"/>
