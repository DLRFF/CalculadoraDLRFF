    <!-- Título superior: ax² + bx + c = 0 -->
    <!-- a -->
    <path android:fillColor="#6750A4" android:pathData="M35,22c-2.2,0 -4,1.8 -4,4s1.8,4 4,4h4v-8h-4zm4,6h-4c-1.1,0 -2,-0.9 -2,-2s0.9,-2 2,-2h4v4z"/>
